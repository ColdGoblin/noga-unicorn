<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Noga and the Unicorn</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#bfe9ff;font-family:"Comic Sans MS","Segoe UI",system-ui,sans-serif;
    -webkit-user-select:none;user-select:none;-webkit-touch-callout:none;touch-action:none}
  canvas{position:fixed;inset:0;width:100%;height:100%;display:block;cursor:pointer}
  .btn{position:fixed;width:19vh;height:19vh;max-width:132px;max-height:132px;border-radius:50%;border:0;
    font-size:0;line-height:1;color:transparent;display:flex;align-items:center;justify-content:center;padding:0;
    background:transparent center/contain no-repeat;filter:drop-shadow(0 6px 6px rgba(0,0,0,.25));cursor:pointer;z-index:5;transition:transform .08s}
  .btn:active,.btn.down{transform:translateY(4px) scale(.94)}
  .btn.hide{display:none}
  #bl{background-image:url(art/ui/btn_left.png)} #br{background-image:url(art/ui/btn_right.png)} #bj{background-image:url(art/ui/btn_jump.png)}
  #bd{background-image:url(art/ui/btn_dance.png)} #bs{background-image:url(art/ui/btn_super.png)}
  #bl,#br{bottom:3vh}
  #bl{left:3vh} #br{left:24vh}
  #bj{bottom:3vh;right:3vh}
  #bd{bottom:3vh;right:24vh}
  #bs{bottom:24vh;right:3vh;opacity:.45}
  #bs.ready{opacity:1}
  .glow{animation:glow .7s ease-in-out infinite alternate}
  @keyframes glow{from{box-shadow:0 0 0 0 rgba(255,255,255,.95),0 6px 0 rgba(0,0,0,.18);transform:scale(1)}
                  to{box-shadow:0 0 0 3vh rgba(255,255,255,0),0 6px 0 rgba(0,0,0,.18);transform:scale(1.14)}}
  .btn.glow{animation:glowb .7s ease-in-out infinite alternate}
  @keyframes glowb{from{filter:drop-shadow(0 0 0 #fff) drop-shadow(0 6px 6px rgba(0,0,0,.25));transform:scale(1)}
                   to{filter:drop-shadow(0 0 2.2vh #fff) drop-shadow(0 0 1vh #fff);transform:scale(1.14)}}
  #snd{position:fixed;bottom:2.5vh;right:50%;transform:translateX(50%);width:max(8vh,44px);height:max(8vh,44px);border-radius:50%;border:3px solid #fff;
    background:rgba(255,255,255,.55);font-size:4vh;z-index:6;cursor:pointer;padding:0}
  #mus{position:fixed;bottom:2.5vh;left:calc(50% - max(13vh,76px));width:max(8vh,44px);height:max(8vh,44px);border-radius:50%;border:3px solid #fff;
    background:rgba(255,255,255,.55);font-size:4vh;z-index:6;cursor:pointer;padding:0;position:fixed;overflow:hidden}
  #mus.off{opacity:.8}#mus i{position:absolute;left:12%;top:46%;width:76%;height:.7vh;background:#e0245e;border-radius:1vh;transform:rotate(-40deg)}
  .screen{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3vh;
    background:linear-gradient(#ffe3f4,#dff3ff)}
  .screen.hide{display:none}
  .screen.clear{background:rgba(255,240,250,.72)}
  h1{margin:0;font-size:9vh;color:#c048a0;text-shadow:0 4px 0 #fff;text-align:center}
  #title{background:url(art/ui/title.jpg) center/cover #e9d9ff;flex-direction:row;justify-content:center;align-items:flex-start;padding-top:3vh;gap:3vw;box-sizing:border-box}
  #title .big{width:17vh;height:17vh;font-size:8vh;flex:none}
  #title h1{font-size:12vh;color:#fff;-webkit-text-stroke:.6vh #b0409a;paint-order:stroke fill;text-shadow:0 .8vh 0 #b0409a,0 1.4vh 2vh rgba(120,40,120,.4)}
  #map{background:#dfe8a8}
  .stage{position:relative;width:min(100vw,177.78vh);height:min(56.25vw,100vh);background:url(art/ui/map.jpg) center/100% 100% no-repeat}
  .stage .stop{position:absolute;width:11.5%;height:auto;aspect-ratio:1;transform:translate(-50%,-50%);font-size:5vh;padding:0}
  .stop img{width:100%;height:100%;object-fit:contain;display:block}
  .stop.play{background:rgba(255,255,255,.82);color:#3ecf6e;font-size:7vh}
  .big{width:26vh;height:26vh;border-radius:50%;border:8px solid #fff;background:#3ecf6e;color:#fff;font-size:13vh;cursor:pointer;
    box-shadow:0 8px 0 rgba(0,0,0,.18);animation:glow .9s ease-in-out infinite alternate;padding:0}
  .row{display:flex;gap:4vh;align-items:center;justify-content:center;flex-wrap:wrap}
  .stop{border-radius:50%;border:.8vh solid #fff;cursor:pointer;padding:0;background:rgba(255,209,234,.55);box-shadow:0 6px 0 rgba(0,0,0,.15)}
  .stop.locked{background:rgba(120,120,120,.45);opacity:.85;cursor:default;font-size:4vh}
  .stop.done{background:rgba(185,242,200,.7)}
  @keyframes glowstop{from{box-shadow:0 0 0 0 rgba(255,255,255,.95),0 6px 0 rgba(0,0,0,.18);transform:translate(-50%,-50%) scale(1)}
                      to{box-shadow:0 0 0 3vh rgba(255,255,255,0),0 6px 0 rgba(0,0,0,.18);transform:translate(-50%,-50%) scale(1.14)}}
  .stop.next{animation:glowstop .9s ease-in-out infinite alternate}
  #sticker{animation:pop .8s cubic-bezier(.2,1.6,.4,1) both}
  #sticker img{height:46vh;width:46vh;object-fit:contain;filter:drop-shadow(0 1vh 1.5vh rgba(0,0,0,.25))}
  @keyframes pop{from{transform:scale(0) rotate(-40deg)}to{transform:scale(1) rotate(0)}}
  .small{width:15vh;height:15vh;border-radius:50%;border:5px solid #fff;font-size:7vh;cursor:pointer;background:#4aa8ff;color:#fff;padding:0;
    box-shadow:0 6px 0 rgba(0,0,0,.15)}
  #rotate{font-size:20vw}
</style>
</head>
<body>
<canvas id="c"></canvas>

<button class="btn" id="bl" aria-label="walk left">&#9664;</button>
<button class="btn" id="br" aria-label="walk right">&#9654;</button>
<button class="btn" id="bj" aria-label="jump">&#11014;</button>
<button class="btn hide" id="bd" aria-label="dance">&#9835;</button>
<button class="btn hide" id="bs" aria-label="super jump">&#9733;</button>
<button id="snd" aria-label="sound">&#128266;</button>
<button id="mus" aria-label="music">&#127925;</button>

<div class="screen" id="title">
  <h1>Noga and the Unicorn</h1>
  <button class="big" id="play" aria-label="play">&#9654;</button>
</div>

<div class="screen hide" id="map">
  <div class="stage" id="stops"></div>
</div>

<div class="screen clear hide" id="end">
  <div id="sticker"></div>
  <div class="row">
    <button class="small" id="toMap" aria-label="map">&#127968;</button>
    <button class="big" id="next" aria-label="next level">&#9654;</button>
  </div>
</div>

<div class="screen hide" id="rotate">&#128260;</div>

<script src="lines.js"></script>
<script src="game.js"></script>
</body>
</html>
